/*
 * Copyright 2026 Google LLC
 * SPDX-License-Identifier: Apache-2.0
 *
 * Hourly non-GenAI log volume rollup materialized directly from raw otel_logs
 * over the incremental lookback window anchored at stg_run_window.window_start.
 * Uses bounded DELETE + INSERT rather than a full-table MERGE to avoid
 * rewriting multi-terabyte daily partitions.
 */
config {
  type: "incremental",
  tags: ["otel_marts"],
  description: "Hourly non-GenAI log volume rollup materialized from raw otel_logs over the incremental lookback window anchored at stg_run_window.window_start.",
  dependencies: ["stg_run_window"],
  bigquery: {
    partitionBy: "DATE(usage_hour)",
    clusterBy: ["service_name", "log_name", "severity"]
  }
}

pre_operations {
  DECLARE window_start TIMESTAMP DEFAULT ${when(incremental(), `(SELECT rw.window_start FROM ${ref("stg_run_window")} AS rw)`, `TIMESTAMP('1970-01-01 00:00:00+00')`)}
  ---
  ${when(incremental(), `BEGIN TRANSACTION`)}
  ---
  ${when(incremental(), `DELETE FROM ${self()} WHERE usage_hour >= window_start`)}
}

SELECT
  TIMESTAMP_TRUNC(timestamp, HOUR) AS usage_hour,
  service_name,
  log_name,
  COALESCE(
    NULLIF(severity_text, ''),
    CASE
      WHEN severity_number >= 21 THEN 'CRITICAL'
      WHEN severity_number >= 17 THEN 'ERROR'
      WHEN severity_number >= 13 THEN 'WARNING'
      WHEN severity_number >= 9 THEN 'INFO'
      WHEN severity_number >= 5 THEN 'DEBUG'
      ELSE 'DEFAULT'
    END
  ) AS severity,
  severity_number,
  COUNT(*) AS log_count,
  SUM(IF(severity_number >= 17, 1, 0)) AS error_count,
  SUM(IF(trace_id IS NOT NULL AND trace_id != '', 1, 0)) AS traced_log_count,
  SUM(IF(insert_id IS NULL, 1, 0)) AS unsynthesized_insert_id_count
FROM ${ref("otel_logs")}
WHERE timestamp >= window_start
  AND NOT (
    COALESCE(NULLIF(event_name, ''), JSON_VALUE(attributes, '$."event.name"'), '') LIKE 'gen_ai.%'
    OR JSON_VALUE(attributes, '$."gen_ai.system"') IS NOT NULL
    OR JSON_VALUE(attributes, '$."gen_ai.provider.name"') IS NOT NULL
    OR JSON_VALUE(attributes, '$."gcp.vertex.agent.invocation_id"') IS NOT NULL
  )
GROUP BY usage_hour, service_name, log_name, severity, severity_number

post_operations {
  ${when(incremental(), `COMMIT TRANSACTION`)}
}
